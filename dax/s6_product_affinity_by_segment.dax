/* ============================================================================
   S6 · PRODUCT AFFINITY BY SEGMENT — DAX MEASURES
   ============================================================================
   Source table (import from sql/s6_browsing_affinity.sql):

       'browsing_affinity'
           activity_date, activity_year, activity_month
           Category            <- most_browsed_category, 'No Category' for blanks
           primary_segment     <- Planner / Splurger / Deadline / ...
           customer_maturity, New_ret
           business_line, LC_Channel, device_type, Store
           sessions, engaged_sessions, orders, NPBE

   Grain reminder: this table is SESSION-grain, not customer-grain — there
   is no master_id here. The Browsing Affinity Index below is therefore a
   SESSION-share ratio (how a segment's browsing sessions distribute across
   categories vs. everyone's), not a purchase-rate ratio. NPBE / Orders are
   the outcomes that happened to land on those sessions, shown alongside it
   — they don't feed the index itself.

   Two separate visuals:
       1. Metrics table  — Rows = Category, Columns = primary_segment (or
          however the page is laid out), Values = the six measures in
          sections 1, 3, 4 and 5/6 shown simultaneously (no tab switcher).
       2. Index matrix    — Rows = Category, Columns = primary_segment,
          Values = [S6 Browsing Affinity Index] only.
   ============================================================================ */


/* ----------------------------------------------------------------------------
   1) BASE MEASURES
   ---------------------------------------------------------------------------- */

S6 Sessions =
SUM ( 'browsing_affinity'[sessions] )

S6 Engaged Sessions =
SUM ( 'browsing_affinity'[engaged_sessions] )

S6 Orders =
SUM ( 'browsing_affinity'[orders] )

S6 NPBE =
SUM ( 'browsing_affinity'[NPBE] )


/* ----------------------------------------------------------------------------
   2) BROWSING AFFINITY INDEX  (separate index matrix)

   index = (segment's share of browsing sessions that landed on this
            category) ÷ (everyone's share of browsing sessions that
            landed on this category)

   Session-based, not order-based — Category = most_browsed_category, so
   this measures where a segment's attention goes while browsing, not
   what they went on to buy.

   DEBUGGING STEP: build and check this with format = Decimal number,
   2 decimal places, BEFORE switching to "0.0""x""". With Rows = Category,
   Columns = primary_segment, Values = [S6 Browsing Affinity Index], the
   matrix Total must read 1.00. If it doesn't, there's a filter-context bug
   — stop and fix it before formatting or shipping the visual.
   ---------------------------------------------------------------------------- */

S6 Segment Sessions All Categories =
CALCULATE (
    [S6 Sessions],
    REMOVEFILTERS ( 'browsing_affinity'[Category] )
)

S6 Segment Category Browse Rate =
DIVIDE (
    [S6 Sessions],
    [S6 Segment Sessions All Categories]
)

S6 Overall Category Sessions =
CALCULATE (
    [S6 Sessions],
    REMOVEFILTERS ( 'browsing_affinity'[primary_segment] )
)

S6 Overall Sessions All Categories =
CALCULATE (
    [S6 Sessions],
    REMOVEFILTERS ( 'browsing_affinity'[Category] ),
    REMOVEFILTERS ( 'browsing_affinity'[primary_segment] )
)

S6 Overall Category Browse Rate =
DIVIDE (
    [S6 Overall Category Sessions],
    [S6 Overall Sessions All Categories]
)

S6 Browsing Affinity Index =
DIVIDE (
    [S6 Segment Category Browse Rate],
    [S6 Overall Category Browse Rate]
)

-- Once the Total checks out at 1.00, switch the format string to:
--   "0.0""x"""


/* ----------------------------------------------------------------------------
   3) NPBE % OF SEGMENT SALES

   Share of a segment's NPBE that comes from sessions that most-browsed
   this category.

   Format: 0.0%
   ---------------------------------------------------------------------------- */

S6 Segment NPBE All Categories =
CALCULATE (
    [S6 NPBE],
    REMOVEFILTERS ( 'browsing_affinity'[Category] )
)

S6 NPBE % of Segment Sales =
DIVIDE (
    [S6 NPBE],
    [S6 Segment NPBE All Categories]
)


/* ----------------------------------------------------------------------------
   4) NPBE PER SESSION

   No master_id in this table, so this is NPBE per session, not per
   customer.

   Format: $#,0
   ---------------------------------------------------------------------------- */

S6 NPBE per Session =
DIVIDE (
    [S6 NPBE],
    [S6 Sessions]
)


/* ----------------------------------------------------------------------------
   5) Δ NPBE SHARE YoY · R7

   Trailing-7-day NPBE share vs. the same trailing-7-day window one year
   earlier, expressed in percentage points (hence * 100 — the mock shows
   "+0.6 pp" / "-0.3 pp", not "+0.006").

   Requires a Date table marked as a Date table, related 1:* to
   'browsing_affinity'[activity_date].

   Dynamic format: "+0.0 ""pp"";-0.0 ""pp"";0.0 ""pp"""
   ---------------------------------------------------------------------------- */

S6 NPBE R7 =
VAR EndDate =
    MAX ( 'Date'[Date] )
RETURN
    CALCULATE (
        [S6 NPBE],
        DATESINPERIOD ( 'Date'[Date], EndDate, -7, DAY )
    )

S6 Segment NPBE R7 All Categories =
CALCULATE (
    [S6 NPBE R7],
    REMOVEFILTERS ( 'browsing_affinity'[Category] )
)

S6 NPBE Share R7 =
DIVIDE (
    [S6 NPBE R7],
    [S6 Segment NPBE R7 All Categories]
)

S6 NPBE Share R7 LY =
CALCULATE (
    [S6 NPBE Share R7],
    DATEADD ( 'Date'[Date], -1, YEAR )
)

S6 Δ Share NPBE YoY pp =
( [S6 NPBE Share R7] - [S6 NPBE Share R7 LY] ) * 100


/* ----------------------------------------------------------------------------
   6) Δ ORDERS SHARE YoY · R7

   Same construction as section 5, on S6 Orders instead of S6 NPBE.

   Dynamic format: "+0.0 ""pp"";-0.0 ""pp"";0.0 ""pp"""
   ---------------------------------------------------------------------------- */

S6 Orders R7 =
VAR EndDate =
    MAX ( 'Date'[Date] )
RETURN
    CALCULATE (
        [S6 Orders],
        DATESINPERIOD ( 'Date'[Date], EndDate, -7, DAY )
    )

S6 Segment Orders R7 All Categories =
CALCULATE (
    [S6 Orders R7],
    REMOVEFILTERS ( 'browsing_affinity'[Category] )
)

S6 Order Share R7 =
DIVIDE (
    [S6 Orders R7],
    [S6 Segment Orders R7 All Categories]
)

S6 Order Share R7 LY =
CALCULATE (
    [S6 Order Share R7],
    DATEADD ( 'Date'[Date], -1, YEAR )
)

S6 Δ Share Orders YoY pp =
( [S6 Order Share R7] - [S6 Order Share R7 LY] ) * 100


/* ----------------------------------------------------------------------------
   7) INDEX MATRIX — CONDITIONAL FORMATTING

   Matrix:
       Rows    = browsing_affinity[Category]
       Columns = browsing_affinity[primary_segment]
       Values  = [S6 Browsing Affinity Index]

   Confirm the Total reads 1.00 with Decimal number / 2 decimals first (see
   section 2's debugging step). Only after that checks out:
     - switch the format string to "0.0""x"""
     - apply the diverging background-color scale:
         Format visual → Cell elements → Background color →
         Format by: Field value → Field: [S6 Browsing Affinity Index] →
         enable Diverging:
           Minimum: Custom value, e.g. 0.5 → rust/pink
           Center:  Number, 1               → neutral/grey
           Maximum: Custom value, e.g. 3    → green

   Turn off row/column subtotals for this matrix — a total row/column
   collapses numerator and denominator to the same population, so an index
   there isn't a meaningful number (it should just be the 1.00 sanity
   check, not a displayed business metric).
   ---------------------------------------------------------------------------- */


/* ----------------------------------------------------------------------------
   OPTIONAL — minimal Date table, if one doesn't already exist in the model.
   Mark it as a Date table (Table tools → Mark as date table) and relate
   'Date'[Date] (1) → 'browsing_affinity'[activity_date] (*).
   ---------------------------------------------------------------------------- */

Date =
ADDCOLUMNS (
    CALENDAR ( DATE ( 2024, 4, 1 ), TODAY () ),
    "Year", YEAR ( [Date] ),
    "Month", FORMAT ( [Date], "MMM" ),
    "MonthNum", MONTH ( [Date] ),
    "YearMonth", FORMAT ( [Date], "YYYY-MM" )
)
